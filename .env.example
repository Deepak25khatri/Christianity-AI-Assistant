# Copy to .env and fill in OPENAI_API_KEY:
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)

# Required — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Auth — use a long random string in production (32+ chars)
JWT_SECRET=dev-jwt-secret-change-me-before-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Qdrant — use http://qdrant:6333 inside Docker, http://localhost:6333 for local dev
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=christianity_kb

# SQLite + ingest artifacts (Docker volume paths; use ./data/... for local dev)
SQLITE_PATH=/data/christianity.db
CANONICAL_BIBLE_PATH=/data/bible_canonical.json
BM25_INDEX_PATH=/data/bm25.pkl

# OpenAI models
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
IMAGE_MODEL=gpt-image-1

# API
RATE_LIMIT_PER_MIN=30
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1
